# ------------------------------------------------------------
# MORTALITY RATES
# ------------------------------------------------------------

# Egg Mortality: Marc (Model 35)
egg.mort.rate <- function(x){
  a1 = 3.518; b1 = -0.183; a2 = -14.119; b2 = 0.416
  m <- (1 - exp(-exp(a1 + b1 * x))) + (1 - exp(-exp(a2 + b2 * x)))
  return(pmin(pmax(m, 0), 1))
}

# Larva Mortality: Gompertz (Model 6)
larva.mort.rate <- function(x){
  a1 = 5.537; b1 = -0.124; a2 = 0; b2 = 0.563
  m <- a1 * exp(b1 * x) + a2 * exp(b2 * x)
  return(pmin(pmax(m, 0), 1))
}

# Pupa Mortality: Wang 3 (Model 28)
pupa.mort.rate <- function(x){
  Topt = 28.084; Bl = 1.467; Bh = 0.878; H = 0.00001
  term <- (1 + exp(-(x - Topt)/Bl)) * (1 + exp(-(Topt - x)/Bh)) * H
  m <- 1 - 1 / term
  m[is.nan(m) | is.infinite(m)] <- 1
  return(pmin(pmax(m, 0), 1))
}

# Adult Mortality (Female): Hilbert & Logan 3 (Model 56)
adult.mort.rate <- function(x){
  trid = -632358.654; Tmax = 38.567; Tmin = 23.682; D = -584677784.227; Dt = 0.017; Smin = 0.09
  r <- trid * (((x - Tmin)^2)/((x - Tmin)^2 + D) - exp(-(Tmax - (x - Tmin))/Dt)) + Smin
  r[is.nan(r) | is.infinite(r)] <- 1
  return(pmin(pmax(r, 0), 1))
}

# ------------------------------------------------------------
# FECUNDITY FUNCTIONS
# ------------------------------------------------------------

# Total fecundity: Brière 2 (Model 40)
fem.total.ovip <- function(x){
  a = 0; To = -69.689; Tl = 39.639; d = 1.395
  r <- exp(a * x * (x - To) * (Tl - x)^(1/d))
  r[is.nan(r) | is.infinite(r)] <- 0
  return(pmin(pmax(r, 0), 1))
}

# Convert total fecundity to daily oviposition rate
fem.daily.ovip <- function(x){
  total <- fem.total.ovip(x)
  lifespan <- 1 / adult.mort.rate(x)
  daily <- total / lifespan
  daily[is.nan(daily) | daily < 0] <- 0
  return(pmin(daily, 1))
}


