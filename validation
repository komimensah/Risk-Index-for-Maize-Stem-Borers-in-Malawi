# DEVELOPMENT RATE FUNCTIONS
# (these you already have)
# ------------------------------------------------------------
egg.dev.rate <- function(x) {
  alph = 117.3314; k = 3474.168; b = 0.1303
  Tmin = 4.5429; Tmax = 56.7699; Dt = 6.2207
  r <- alph * (1 / (1 + k * exp(-b * (x - Tmin))) -
                 exp(-(Tmax - (x - Tmin)) / Dt))
  r[is.nan(r) | r < 0] <- 0
  return(pmin(r, 1))
}

larva.dev.rate <- function(x) {
  Y = 0.0012; Tmax = 31.2287; p = 0.1163; v = 1.6537
  r <- Y * (exp(p * x) - exp((p * Tmax) - (Tmax - x) / v))
  r[is.nan(r) | r < 0] <- 0
  return(pmin(r, 1))
}

pupa.dev.rate <- function(x) {
  Y = 0.006; Tmax = 33.0391; p = 0.1641; v = 5.2269
  r <- Y * (exp(p * x) - exp((p * Tmax) - (Tmax - x) / v))
  r[is.nan(r) | r < 0] <- 0
  return(pmin(r, 1))
}

# ------------------------------------------------------------
# MORTALITY RATE FUNCTIONS
# ------------------------------------------------------------
egg.mort.rate <- function(x) {
  b1 = 5.0138; b2 = -0.4869; b3 = 0.01
  m <- exp(b1 + b2 * x + b3 * x^2)
  m[is.nan(m) | m < 0] <- 0
  return(pmin(m, 1))
}

larva.mort.rate <- function(x) {
  b1 = 3.8718; b2 = -0.3872; b3 = 0.0078
  m <- exp(b1 + b2 * x + b3 * x^2)
  m[is.nan(m) | m < 0] <- 0
  return(pmin(m, 1))
}

pupa.mort.rate <- function(x) {
  b1 = 7.6441; b2 = -0.7716; b3 = 0.0157
  m <- exp(b1 + b2 * x + b3 * x^2)
  m[is.nan(m) | m < 0] <- 0
  return(pmin(m, 1))
}

female.mort.rate <- function(x) {
  c1 = 79.0854; k1 = 8.1594; k2 = -0.073
  m <- c1 / (1 + exp(k1 + k2 * x))
  m[is.nan(m) | m < 0] <- 0
  return(pmin(m, 1))
}

# ------------------------------------------------------------
# FECUNDITY FUNCTIONS
# ------------------------------------------------------------
fem.tot.ovip <- function(x) {
  b1 = -3.7017; b2 = 0.8449; b3 = -0.0188
  r <- exp(b1 + b2 * x + b3 * x^2)
  r[is.nan(r) | r < 0] <- 0
  return(r)
}

fem.fec <- function(x) {
  total_eggs <- fem.tot.ovip(x)
  lifespan <- 1 / female.mort.rate(x)
  fec <- total_eggs / lifespan
  fec[is.nan(fec) | fec < 0] <- 0
  return(fec)
}

# ------------------------------------------------------------
# TEMPERATURE‐RESPONSE (Yan & Hunt style)
# ------------------------------------------------------------
r_yan <- function(T, Rmax = 0.04545, Topt = 31.4, Tmax = 41) {
  T <- as.numeric(T)
  r <- ifelse(T < 0 | T > Tmax, 0,
              Rmax * ((Tmax - T) / (Tmax - Topt)) *
                ((T / Topt)^(Topt / (Tmax - Topt))))
  r[is.nan(r) | r < 0] <- 0
  return(r)
}

# ------------------------------------------------------------
# R0 (Risk Index) FUNCTION USING TEMPERATURE & RESOURCE
# ------------------------------------------------------------
risk.index_temp_resource <- function(Tvec) {
  rvec <- rep(NA_real_, length(Tvec))
  good <- !is.na(Tvec)
  
  if (any(good)) {
    Tgood <- Tvec[good]
    
    # Temperature‐dependent components:
    gamma <- r_yan(Tgood)
    gamma[is.nan(gamma) | gamma < 0] <- 0
    D1 <- egg.dev.rate(Tgood)
    D2 <- larva.dev.rate(Tgood)
    D3 <- pupa.dev.rate(Tgood)
    M1 <- egg.mort.rate(Tgood)
    M2 <- larva.mort.rate(Tgood)
    M3 <- pupa.mort.rate(Tgood)
    M4 <- female.mort.rate(Tgood)
    phi <- fem.fec(Tgood)
    
    # RESOURCE PARAMETERS (you need to supply realistic values)
    
    mu_R  <- 0.003   # example: resource decay rate
    R_star <- gamma / mu_R
    
    # Option: adult‐induced resource boost could be included,
    # but for simplicity we use baseline R_star only.
    
    # Now compute R0 with the derived formula:
    #The exit rate from larval stage: how fast larvae leave (either by becoming pupae or dying)
    #If this is high → larvae turn over quickly → many “waves” of larvae over the year → higher cumulative counts → positive correlation.
    
    #((D1 + M1) * (D2 + M2) * (D3 + M3) * M4)
    R0_good <-  
      (D2 + M2) 
    # Ensuring no negative or NaNs:
    R0_good[is.nan(R0_good) | R0_good < 0] <- 0
    rvec[good] <- R0_good
  }
  
  return(rvec)
}

