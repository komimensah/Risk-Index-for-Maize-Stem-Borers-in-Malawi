# Yan & Hunt temperature-response function
r_yan <- function(T, Rmax = 1, Topt = 25, Tmax = 40) {
  # ensure T ≤ Tmax
  r <- ifelse(T < 0 | T > Tmax, 0,
              Rmax * ((Tmax - T) / (Tmax - Topt)) *
                (T / Topt)^(Topt / (Tmax - Topt)))
  return(r)
}

# Example parameters
Rmax <-  0.04545 #d–1 
Topt <- 31.4
Tmax <- 41

# Temperature sequence
temps <- seq(0, 45, by = 0.1)

# Compute rates
rates <- r_yan(temps, Rmax = Rmax, Topt = Topt, Tmax = Tmax)

# Plot
plot(temps, rates, type = "l", lwd = 2, col = "blue",
     xlab = "Temperature (°C)", ylab = "r(T) — normalized rate",
     main = "Yan & Hunt Temperature Response Curve")
abline(v = Topt, lty = 2, col = "red")
text(Topt + 1, Rmax * 0.9, paste("Topt =", Topt), col = "red")
